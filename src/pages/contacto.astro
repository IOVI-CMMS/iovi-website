---
import "./styles/global.css";
import Header from "./components/Header.astro";
import Footer from "./components/Footer.astro";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <meta
      name="description"
      content="Contacta al equipo de IOVI para resolver dudas, solicitar información o recibir asistencia."
    />

    <link rel="icon" type="image/svg+xml" href="/logo.svg" />

    <title>Contacto | IOVI CMMS</title>
  </head>

  <body>
    <Header />

    <main>
      <!-- PRESENTACIÓN -->
      <section class="contact-hero">
        <div class="container contact-hero-content">
          <span class="contact-eyebrow">Contacto</span>

          <h1>Estamos aquí para ayudarte</h1>

          <p>
            ¿Tienes dudas sobre IOVI, necesitas más información o quieres
            conocer cómo nuestra plataforma puede adaptarse a tu institución?
            Envíanos un mensaje.
          </p>
        </div>
      </section>

      <!-- FORMULARIO -->
      <section class="contact-form-section">
        <div class="container contact-grid">
          <div class="contact-introduction">
            <span class="section-label">Escríbenos</span>

            <h2>Envíanos un mensaje</h2>

            <p>
              Completa el formulario y nos pondremos en contacto contigo lo
              antes posible.
            </p>

            <div class="response-card">
              <span>✓</span>

              <div>
                <strong>Atención personalizada</strong>

                <p>
                  Respondemos la mayoría de los mensajes en menos de
                  24 horas hábiles.
                </p>
              </div>
            </div>
          </div>

          <form class="contact-form" id="contact-form">
            <div class="form-row">
              <label>
                Nombre completo
                <input
                  type="text"
                  name="nombre"
                  placeholder="Tu nombre"
                  required
                />
              </label>

              <label>
                Empresa o institución
                <input
                  type="text"
                  name="empresa"
                  placeholder="Nombre de la institución"
                />
              </label>
            </div>

            <label>
              Correo electrónico
              <input
                type="email"
                name="correo"
                placeholder="nombre@empresa.com"
                required
              />
            </label>

            <label>
              Asunto
              <select name="asunto" required>
                <option value="">Selecciona una opción</option>
                <option value="informacion">Información sobre IOVI</option>
                <option value="soporte">Soporte</option>
                <option value="alianza">Alianzas o colaboración</option>
                <option value="facturacion">Facturación</option>
                <option value="otro">Otro asunto</option>
              </select>
            </label>

            <label>
              Mensaje
              <textarea
                name="mensaje"
                rows="6"
                placeholder="Cuéntanos cómo podemos ayudarte"
                required
              ></textarea>
            </label>

<div class="form-consent">
  <label class="checkbox-row">
    <input
      type="checkbox"
      id="contact-privacy"
      name="privacyAccepted"
      required
    />

    <span>
      He leído y acepto el
      <a
        href="/aviso-de-privacidad"
        target="_blank"
        rel="noopener noreferrer"
      >
        Aviso de Privacidad
      </a>.
      <strong aria-hidden="true">*</strong>
    </span>
  </label>

  <p class="privacy-description">
    Al enviar este formulario autorizo el tratamiento de mis datos personales
    conforme al Aviso de Privacidad.
  </p>
</div>

<button
  type="submit"
  id="contact-submit"
  disabled
>
  Enviar mensaje
</button>

            <p class="form-status" id="form-status" aria-live="polite"></p>
          </form>
        </div>
      </section>

      <!-- INFORMACIÓN DE CONTACTO -->
      <section class="contact-information">
        <div class="container">
          <div class="information-heading">
            <span class="section-label">Información de contacto</span>

            <h2>Otros medios para comunicarte con nosotros</h2>
          </div>

          <div class="information-grid">
            <article class="information-card">
              <div class="information-icon">✉</div>

              <span>Correo electrónico</span>

              <h3>
                <a href="mailto:contacto@iovicmms.com">
                  contacto@iovicmms.com
                </a>
              </h3>

              <p>
                Para consultas generales, soporte o información sobre la
                plataforma.
              </p>
            </article>

            <article class="information-card">
              <div class="information-icon">⌖</div>

              <span>Ubicación</span>

              <h3>Hermosillo, Sonora, México</h3>

              <p>
                Atendemos instituciones y empresas de distintas regiones de
                México.
              </p>
            </article>

            <article class="information-card">
              <div class="information-icon">◷</div>

              <span>Horario de atención</span>

              <h3>Lunes a viernes</h3>

              <p>
                9:00 a.m. a 6:00 p.m., horario de Hermosillo.
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- CTA -->
      <section class="contact-cta">
        <div class="container">
          <div class="contact-cta-box">
            <span>Demostración personalizada</span>

            <h2>¿Quieres conocer IOVI en acción?</h2>

            <p>
              Descubre cómo IOVI puede ayudarte a optimizar la gestión de tus
              equipos biomédicos.
            </p>

            <a href="/demo">Solicitar demo</a>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <script>
      const form = document.querySelector("#contact-form");
      const status = document.querySelector("#form-status");

      form?.addEventListener("submit", (event) => {
        event.preventDefault();

        if (status) {
          status.textContent =
            "Formulario de muestra: la conexión para enviar mensajes se agregará próximamente.";
        }
      });
    </script>
    <script>
  const privacyCheckbox = document.querySelector("#contact-privacy");
  const submitButton = document.querySelector("#contact-submit");

  if (
    privacyCheckbox instanceof HTMLInputElement &&
    submitButton instanceof HTMLButtonElement
  ) {
    const updateSubmitButton = () => {
      submitButton.disabled = !privacyCheckbox.checked;
    };

    privacyCheckbox.addEventListener("change", updateSubmitButton);
    updateSubmitButton();
  }
</script>
  </body>
</html>

<style>
  .contact-hero {
    position: relative;
    overflow: hidden;
    padding: 115px 0 105px;
    background:
      linear-gradient(rgb(37 99 235 / 4%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(37 99 235 / 4%) 1px, transparent 1px),
      radial-gradient(
        circle at 80% 15%,
        rgb(6 182 212 / 15%),
        transparent 30%
      ),
      #f8fbff;
    background-size:
      54px 54px,
      54px 54px,
      auto,
      auto;
  }

  .contact-hero-content {
    max-width: 850px;
    text-align: center;
  }

  .contact-eyebrow,
  .section-label {
    color: var(--primary);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .contact-hero h1 {
    margin: 20px 0;
    color: var(--navy);
    font-size: clamp(3.2rem, 7vw, 6rem);
    line-height: 0.98;
    letter-spacing: -0.06em;
  }

  .contact-hero p {
    max-width: 720px;
    margin: 0 auto;
    color: var(--muted);
    font-size: 1.06rem;
    line-height: 1.8;
  }

  .contact-form-section {
    padding: 110px 0;
    background: white;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 0.82fr 1.18fr;
    align-items: start;
    gap: 80px;
  }

  .contact-introduction {
    position: sticky;
    top: 120px;
  }

  .contact-introduction h2,
  .information-heading h2 {
    margin: 18px 0 20px;
    color: var(--navy);
    font-size: clamp(2.2rem, 4vw, 3.7rem);
    line-height: 1.08;
    letter-spacing: -0.045em;
  }

  .contact-introduction > p {
    margin: 0;
    color: var(--muted);
    line-height: 1.8;
  }

  .response-card {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    margin-top: 35px;
    padding: 20px;
    border: 1px solid rgb(37 99 235 / 12%);
    border-radius: 17px;
    background: #f5f8ff;
  }

  .response-card > span {
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    border-radius: 50%;
    color: white;
    background: var(--primary);
    font-size: 0.8rem;
    font-weight: 900;
  }

  .response-card strong {
    color: var(--navy);
    font-size: 0.9rem;
  }

  .response-card p {
    margin: 6px 0 0;
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.55;
  }

  .contact-form {
    display: grid;
    gap: 21px;
    padding: 36px;
    border: 1px solid rgb(148 163 184 / 18%);
    border-radius: 26px;
    background: white;
    box-shadow: 0 25px 65px rgb(15 23 42 / 10%);
  }

  .form-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }

  .contact-form label {
    display: grid;
    gap: 9px;
    color: var(--navy);
    font-size: 0.84rem;
    font-weight: 750;
  }

  .contact-form input,
  .contact-form select,
  .contact-form textarea {
    width: 100%;
    border: 1px solid var(--border);
    border-radius: 11px;
    outline: none;
    color: var(--text);
    background: white;
    font: inherit;
    font-size: 0.9rem;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .contact-form input,
  .contact-form select {
    min-height: 49px;
    padding: 0 14px;
  }

  .contact-form textarea {
    min-height: 145px;
    padding: 14px;
    resize: vertical;
  }

  .contact-form input:focus,
  .contact-form select:focus,
  .contact-form textarea:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 4px rgb(37 99 235 / 10%);
  }

  .privacy-check {
    display: flex !important;
    align-items: flex-start;
    gap: 10px !important;
    color: var(--muted) !important;
    font-weight: 500 !important;
    line-height: 1.5;
  }

  .privacy-check input {
    width: 17px;
    height: 17px;
    min-height: auto;
    margin-top: 2px;
  }

  .privacy-check a {
    color: var(--primary);
    font-weight: 750;
  }

  .contact-submit {
    min-height: 51px;
    border: 0;
    border-radius: 11px;
    color: white;
    background: var(--primary);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 800;
    cursor: pointer;
    box-shadow: 0 15px 34px rgb(37 99 235 / 24%);
    transition:
      transform 0.2s ease,
      background 0.2s ease,
      box-shadow 0.2s ease;
  }

  .contact-submit:hover {
    transform: translateY(-2px);
    background: #1d4ed8;
    box-shadow: 0 20px 42px rgb(37 99 235 / 30%);
  }

  .form-status {
    min-height: 20px;
    margin: -5px 0 0;
    color: var(--muted);
    text-align: center;
    font-size: 0.76rem;
    line-height: 1.5;
  }

  .contact-information {
    padding: 105px 0;
    background: #f1f5ff;
  }

  .information-heading {
    max-width: 750px;
    margin: 0 auto 55px;
    text-align: center;
  }

  .information-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .information-card {
    min-height: 300px;
    padding: 30px;
    border: 1px solid rgb(148 163 184 / 16%);
    border-radius: 23px;
    background: white;
    box-shadow: 0 18px 45px rgb(15 23 42 / 6%);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .information-card:hover {
    transform: translateY(-7px);
    box-shadow: 0 27px 60px rgb(37 99 235 / 12%);
  }

  .information-icon {
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    margin-bottom: 28px;
    border-radius: 16px;
    color: white;
    background: linear-gradient(
      135deg,
      var(--primary),
      var(--secondary)
    );
    box-shadow: 0 14px 30px rgb(37 99 235 / 23%);
    font-size: 1.25rem;
    font-weight: 900;
  }

  .information-card > span {
    color: var(--primary);
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .information-card h3 {
    margin: 12px 0;
    color: var(--navy);
    font-size: 1.15rem;
    overflow-wrap: anywhere;
  }

  .information-card h3 a:hover {
    color: var(--primary);
  }

  .information-card p {
    margin: 0;
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.7;
  }

  .contact-cta {
    padding: 30px 0 100px;
    background: white;
  }

  .contact-cta-box {
    padding: 80px 30px;
    border-radius: 34px;
    color: white;
    text-align: center;
    background:
      radial-gradient(
        circle at 15% 20%,
        rgb(255 255 255 / 18%),
        transparent 25%
      ),
      linear-gradient(135deg, #1d4ed8, #2563eb 60%, #0891b2);
    box-shadow: 0 30px 70px rgb(37 99 235 / 25%);
  }

  .contact-cta-box > span {
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .contact-cta-box h2 {
    max-width: 730px;
    margin: 18px auto;
    color: white;
    font-size: clamp(2.3rem, 5vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.045em;
  }

  .contact-cta-box p {
    max-width: 610px;
    margin: 0 auto 30px;
    color: rgb(255 255 255 / 78%);
    line-height: 1.75;
  }

  .contact-cta-box a {
    min-height: 52px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 27px;
    border-radius: 12px;
    color: var(--primary);
    background: white;
    font-weight: 800;
    box-shadow: 0 15px 35px rgb(15 23 42 / 18%);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .contact-cta-box a:hover {
    transform: translateY(-3px);
    box-shadow: 0 20px 42px rgb(15 23 42 / 24%);
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 50px;
    }

    .contact-introduction {
      position: static;
      text-align: center;
    }

    .contact-introduction > p {
      max-width: 650px;
      margin-inline: auto;
    }

    .response-card {
      max-width: 480px;
      margin-inline: auto;
      text-align: left;
    }

    .information-grid {
      grid-template-columns: 1fr;
      max-width: 650px;
      margin-inline: auto;
    }

    .information-card {
      min-height: auto;
    }
  }

  @media (max-width: 620px) {
    .contact-hero {
      padding: 85px 0;
    }

    .contact-hero h1 {
      font-size: clamp(2.9rem, 14vw, 4.5rem);
    }

    .contact-form-section,
    .contact-information {
      padding: 80px 0;
    }

    .form-row {
      grid-template-columns: 1fr;
    }

    .contact-form {
      padding: 24px;
    }

    .contact-cta-box {
      padding: 60px 24px;
      border-radius: 25px;
    }
  }
  .form-consent {
  display: grid;
  gap: 10px;
  margin: 8px 0 22px;
}

.checkbox-row {
  display: flex;
  align-items: flex-start;
  gap: 11px;
  cursor: pointer;
  color: var(--muted);
  font-size: 0.86rem;
  line-height: 1.55;
}

.checkbox-row input {
  width: 17px;
  height: 17px;
  min-width: 17px;
  margin-top: 2px;
  accent-color: var(--primary);
  cursor: pointer;
}

.checkbox-row span {
  display: block;
}

.checkbox-row a {
  color: var(--primary);
  font-weight: 750;
  text-decoration: none;
}

.checkbox-row a:hover {
  text-decoration: underline;
}

.checkbox-row strong {
  color: #dc2626;
}

.privacy-description {
  margin: -3px 0 3px 28px;
  color: var(--muted);
  font-size: 0.74rem;
  line-height: 1.5;
}

.optional-checkbox {
  margin-top: 3px;
}

button[type="submit"]:disabled {
  cursor: not-allowed;
  opacity: 0.5;
  transform: none;
  box-shadow: none;
}

button[type="submit"]:disabled:hover {
  transform: none;
  box-shadow: none;
}

@media (max-width: 600px) {
  .checkbox-row {
    font-size: 0.82rem;
  }

  .privacy-description {
    margin-left: 28px;
    font-size: 0.71rem;
  }
}
</style>