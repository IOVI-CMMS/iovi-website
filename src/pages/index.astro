<Footer />
</body>
<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: 88px 0 96px;
    background:
      radial-gradient(circle at 15% 15%, rgb(37 99 235 / 10%), transparent 32%),
      radial-gradient(circle at 85% 25%, rgb(6 182 212 / 10%), transparent 28%),
      linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(rgb(37 99 235 / 4%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(37 99 235 / 4%) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: linear-gradient(to bottom, black, transparent 90%);
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.02fr 0.98fr;
    align-items: center;
    gap: 72px;
  }

  .hero-content {
    animation: heroFadeUp 0.8s ease both;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border: 1px solid rgb(6 182 212 / 20%);
    border-radius: 999px;
    color: #0e7490;
    background: rgb(6 182 212 / 8%);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .hero-badge::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--secondary);
    box-shadow: 0 0 0 5px rgb(6 182 212 / 12%);
  }

  .hero h1 {
    max-width: 700px;
    margin: 24px 0 18px;
    font-size: clamp(2.6rem, 5.5vw, 5.2rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .hero-description {
    max-width: 640px;
    margin: 0;
    color: var(--text);
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }

  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    margin-top: 28px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
  }

  .hero-stats div {
    display: grid;
    gap: 4px;
  }

  .hero-stats strong {
    font-size: 1rem;
  }

  .hero-stats span {
    color: var(--muted);
    font-size: 0.78rem;
  }

  .hero-visual {
    position: relative;
    min-height: 520px;
    display: grid;
    place-items: center;
    animation: heroFadeIn 1s ease 0.15s both;
  }

  .glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(10px);
    opacity: 0.7;
  }

  .glow-one {
    width: 240px;
    height: 240px;
    top: 20px;
    right: 20px;
    background: rgb(37 99 235 / 18%);
  }

  .glow-two {
    width: 180px;
    height: 180px;
    bottom: 20px;
    left: 25px;
    background: rgb(6 182 212 / 16%);
  }

  .dashboard-card {
    position: relative;
    z-index: 2;
    width: min(100%, 560px);
    overflow: hidden;
    border: 1px solid rgb(148 163 184 / 20%);
    border-radius: 24px;
    background: white;
    box-shadow:
      0 35px 80px rgb(15 23 42 / 18%),
      0 8px 24px rgb(37 99 235 / 12%);
    transform: perspective(1200px) rotateY(-4deg) rotateX(2deg);
    animation: floatDashboard 5s ease-in-out infinite;
  }

  .dashboard-top {
    display: flex;
    gap: 7px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--border);
    background: #f8fafc;
  }

  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #cbd5e1;
  }

  .dashboard-body {
    display: grid;
    grid-template-columns: 86px 1fr;
    min-height: 340px;
  }

  .mock-sidebar {
    background:
      linear-gradient(#1d4ed8 0 0) 18px 30px / 50px 8px no-repeat,
      linear-gradient(#dbeafe 0 0) 18px 58px / 42px 6px no-repeat,
      linear-gradient(#dbeafe 0 0) 18px 88px / 48px 6px no-repeat,
      linear-gradient(#dbeafe 0 0) 18px 118px / 36px 6px no-repeat,
      linear-gradient(#dbeafe 0 0) 18px 148px / 44px 6px no-repeat,
      #eff6ff;
  }

  .mock-content {
    padding: 26px;
  }

  .mock-heading {
    width: 42%;
    height: 18px;
    border-radius: 6px;
    background: #cbd5e1;
  }

  .mock-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-top: 22px;
  }

  .mock-cards div {
    height: 82px;
    border-radius: 14px;
    background:
      linear-gradient(135deg, rgb(37 99 235 / 12%), rgb(6 182 212 / 8%));
    border: 1px solid rgb(37 99 235 / 10%);
  }

  .mock-table {
    display: grid;
    gap: 12px;
    margin-top: 24px;
  }

  .mock-table span {
    height: 24px;
    border-radius: 7px;
    background: #f1f5f9;
  }

  .floating-card {
    position: absolute;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 210px;
    padding: 14px 16px;
    border: 1px solid rgb(148 163 184 / 18%);
    border-radius: 16px;
    background: rgb(255 255 255 / 88%);
    box-shadow: 0 18px 45px rgb(15 23 42 / 14%);
    backdrop-filter: blur(14px);
  }

  .floating-card strong,
  .floating-card small {
    display: block;
  }

  .floating-card strong {
    font-size: 0.84rem;
  }

  .floating-card small {
    margin-top: 3px;
    color: var(--muted);
    font-size: 0.7rem;
  }

  .floating-icon {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    border-radius: 10px;
    color: white;
    background: var(--primary);
    font-weight: 800;
  }

  .floating-card-one {
    left: 0;
    bottom: 90px;
    animation: floatCard 4s ease-in-out infinite;
  }

  .floating-card-two {
    top: 90px;
    right: -16px;
    animation: floatCard 4.6s ease-in-out 0.6s infinite;
  }

  @keyframes heroFadeUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes heroFadeIn {
    from {
      opacity: 0;
      transform: scale(0.97);
    }

    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes floatDashboard {
    0%,
    100% {
      transform: perspective(1200px) rotateY(-4deg) rotateX(2deg) translateY(0);
    }

    50% {
      transform: perspective(1200px) rotateY(-4deg) rotateX(2deg) translateY(-12px);
    }
  }

  @keyframes floatCard {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-10px);
    }
  }

  @media (max-width: 980px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .hero-content {
      text-align: center;
    }

    .hero-description {
      margin-inline: auto;
    }

    .hero-actions,
    .hero-stats {
      justify-content: center;
    }

    .hero-visual {
      min-height: 480px;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding: 64px 0 72px;
    }

    .hero h1 {
      font-size: clamp(2.4rem, 12vw, 3.5rem);
    }

    .hero-actions {
      display: grid;
    }

    .hero-actions .btn {
      width: 100%;
    }

    .hero-stats {
      display: grid;
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .hero-visual {
      min-height: 390px;
    }

    .dashboard-card {
      transform: none;
    }

    .dashboard-body {
      grid-template-columns: 60px 1fr;
      min-height: 270px;
    }

    .mock-content {
      padding: 18px;
    }

    .floating-card {
      min-width: 180px;
      padding: 12px;
    }

    .floating-card-one {
      left: -8px;
      bottom: 34px;
    }

    .floating-card-two {
      top: 34px;
      right: -8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-content,
    .hero-visual,
    .dashboard-card,
    .floating-card {
      animation: none;
    }
  }
    .solutions {
    background: #eef4ff;
  }

  .features {
    background: #f8fafc;
  }

  .section-heading {
    text-align: center;
    margin-bottom: 48px;
  }

  .section-heading h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3rem);
