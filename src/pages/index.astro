  }

  .solution-card h3 {
    margin: 22px 0 12px;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
  }

  .solution-card p {
    margin: 0;
    color: var(--muted);
    line-height: 1.7;
    font-size: 0.92rem;
  }

  .feature-icon {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border-radius: 14px;
    font-size: 1.35rem;
    font-weight: 800;
  }

  .feature-icon-blue {
    color: #1d4ed8;
    background: #e0e7ff;
  }

  .feature-icon-cyan {
    color: #0e7490;
    background: #cffafe;
