---
import "./styles/global.css";
import Header from "./components/Header.astro";
import Footer from "./components/Footer.astro";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <meta
      name="description"
      content="Conoce IOVI, una plataforma creada para simplificar la gestión del equipamiento biomédico."
    />

    <link rel="icon" type="image/svg+xml" href="/logo.svg" />

    <title>Nosotros | IOVI CMMS</title>
  </head>

  <body>
    <Header />

    <main>
      <!-- PRESENTACIÓN -->
      <section class="about-hero">
        <div class="container about-hero-content">
          <span class="about-eyebrow">Sobre IOVI</span>

          <h1>
            Tecnología creada para simplificar la gestión biomédica
          </h1>

          <p>
            IOVI es una plataforma enfocada en centralizar el inventario,
            mantenimiento e historial de equipos biomédicos mediante una
            experiencia clara, accesible y eficiente.
          </p>
        </div>
      </section>

      <!-- HISTORIA -->
      <section class="about-story">
        <div class="container story-grid">
          <div class="story-copy">
            <span class="section-label">Nuestra historia</span>

            <h2>Una solución nacida desde las necesidades reales del sector</h2>

            <p>
              IOVI surge al identificar los retos que enfrentan hospitales,
              clínicas y profesionales biomédicos para mantener organizada la
              información de sus equipos.
            </p>

            <p>
              Registros dispersos, seguimientos manuales y poca visibilidad del
              historial técnico dificultan la toma de decisiones y consumen
              tiempo valioso.
            </p>

            <p>
              Por eso desarrollamos una plataforma que reúne la información
              esencial en un solo lugar y facilita el seguimiento de cada
              equipo durante su ciclo de vida.
            </p>
          </div>

          <div class="story-visual" aria-hidden="true">
            <div class="visual-card visual-card-main">
              <span>IOVI CMMS</span>
              <strong>Gestión biomédica centralizada</strong>

              <div class="visual-lines">
                <i></i>
                <i></i>
                <i></i>
              </div>
            </div>

            <div class="visual-card visual-card-small">
              <strong>Una plataforma</strong>
              <span>Inventario + mantenimiento + historial</span>
            </div>
          </div>
        </div>
      </section>

      <!-- MISIÓN, VISIÓN Y PROPÓSITO -->
      <section class="about-principles">
        <div class="container">
          <div class="principles-heading">
            <span class="section-label">Lo que nos impulsa</span>
            <h2>Construimos una gestión más simple y confiable</h2>
          </div>

          <div class="principles-grid">
            <article class="principle-card">
              <span class="principle-number">01</span>
              <div class="principle-icon">↗</div>

              <h3>Nuestra misión</h3>

              <p>
                Facilitar la gestión del equipamiento biomédico mediante
                herramientas digitales intuitivas que mejoren la organización,
                trazabilidad y eficiencia operativa.
              </p>
            </article>

            <article class="principle-card">
              <span class="principle-number">02</span>
              <div class="principle-icon">◎</div>

              <h3>Nuestra visión</h3>

              <p>
                Convertir a IOVI en una plataforma de referencia para la gestión
                biomédica en México y Latinoamérica.
              </p>
            </article>

            <article class="principle-card">
              <span class="principle-number">03</span>
              <div class="principle-icon">✓</div>

              <h3>Nuestro propósito</h3>

              <p>
                Ayudar a que cada institución tenga información clara y
                disponible para tomar mejores decisiones sobre sus equipos.
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- VALORES -->
      <section class="about-values">
        <div class="container values-grid">
          <div class="values-intro">
            <span class="section-label">Nuestros valores</span>

            <h2>Principios que guían cada decisión</h2>

            <p>
              Diseñamos IOVI pensando en la confianza, facilidad de uso y
              necesidades reales de quienes administran tecnología biomédica.
            </p>
          </div>

          <div class="values-list">
            <article>
              <span>01</span>

              <div>
                <h3>Simplicidad</h3>
                <p>
                  Creamos herramientas fáciles de entender y utilizar.
                </p>
              </div>
            </article>

            <article>
              <span>02</span>

              <div>
                <h3>Confiabilidad</h3>
                <p>
                  Buscamos que la información sea organizada, accesible y útil.
                </p>
              </div>
            </article>

            <article>
              <span>03</span>

              <div>
                <h3>Innovación</h3>
                <p>
                  Mejoramos continuamente para responder a nuevos retos.
                </p>
              </div>
            </article>

            <article>
              <span>04</span>

              <div>
                <h3>Enfoque biomédico</h3>
                <p>
                  Desarrollamos desde el conocimiento y contexto del sector.
                </p>
              </div>
            </article>
          </div>
        </div>
      </section>

      <!-- CTA -->
      <section class="about-cta">
        <div class="container">
          <div class="cta-box">
            <span>Conoce la plataforma</span>

            <h2>
              Descubre cómo IOVI puede adaptarse a tu institución
            </h2>

            <p>
              Agenda una demostración personalizada y conoce sus principales
              funcionalidades.
            </p>

            <a href="/demo">Solicitar demo</a>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  .about-hero {
    position: relative;
    overflow: hidden;
    padding: 120px 0;
    background:
      linear-gradient(rgb(37 99 235 / 4%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(37 99 235 / 4%) 1px, transparent 1px),
      radial-gradient(
        circle at 80% 20%,
        rgb(6 182 212 / 16%),
        transparent 30%
      ),
      #f8fbff;
    background-size:
      54px 54px,
      54px 54px,
      auto,
      auto;
  }

  .about-hero-content {
    max-width: 900px;
    text-align: center;
  }

  .about-eyebrow,
  .section-label {
    color: var(--primary);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .about-hero h1 {
    max-width: 850px;
    margin: 22px auto;
    color: var(--navy);
    font-size: clamp(3rem, 7vw, 6rem);
    line-height: 0.98;
    letter-spacing: -0.06em;
  }

  .about-hero p {
    max-width: 720px;
    margin: 0 auto;
    color: var(--muted);
    font-size: 1.08rem;
    line-height: 1.8;
  }

  .about-story {
    padding: 110px 0;
    background: white;
  }

  .story-grid {
    display: grid;
    grid-template-columns: 1fr 0.9fr;
    align-items: center;
    gap: 80px;
  }

  .story-copy h2,
  .principles-heading h2,
  .values-intro h2 {
    margin: 18px 0 24px;
    color: var(--navy);
    font-size: clamp(2.2rem, 4vw, 3.7rem);
    line-height: 1.08;
    letter-spacing: -0.045em;
  }

  .story-copy p,
  .values-intro p {
    margin: 0 0 18px;
    color: var(--muted);
    line-height: 1.85;
  }

  .story-visual {
    position: relative;
    min-height: 430px;
    display: grid;
    place-items: center;
  }

  .story-visual::before {
    content: "";
    position: absolute;
    width: 340px;
    height: 340px;
    border-radius: 50%;
    background: linear-gradient(
      135deg,
      rgb(37 99 235 / 22%),
      rgb(6 182 212 / 20%)
    );
    filter: blur(3px);
  }

  .visual-card {
    position: absolute;
    border: 1px solid rgb(37 99 235 / 12%);
    background: rgb(255 255 255 / 92%);
    box-shadow: 0 30px 70px rgb(15 23 42 / 14%);
    backdrop-filter: blur(15px);
  }

  .visual-card-main {
    z-index: 2;
    width: min(390px, 90%);
    padding: 34px;
    border-radius: 28px;
  }

  .visual-card-main span {
    color: var(--primary);
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.1em;
  }

  .visual-card-main strong {
    display: block;
    margin-top: 14px;
    color: var(--navy);
    font-size: 1.7rem;
    line-height: 1.2;
  }

  .visual-lines {
    display: grid;
    gap: 12px;
    margin-top: 34px;
  }

  .visual-lines i {
    height: 12px;
    border-radius: 999px;
    background: #e8eef9;
  }

  .visual-lines i:nth-child(1) {
    width: 90%;
  }

  .visual-lines i:nth-child(2) {
    width: 70%;
  }

  .visual-lines i:nth-child(3) {
    width: 82%;
  }

  .visual-card-small {
    z-index: 3;
    right: 0;
    bottom: 35px;
    width: 245px;
    padding: 22px;
    border-radius: 20px;
  }

  .visual-card-small strong,
  .visual-card-small span {
    display: block;
  }

  .visual-card-small strong {
    color: var(--navy);
  }

  .visual-card-small span {
    margin-top: 8px;
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .about-principles {
    padding: 110px 0;
    background: #f1f5ff;
  }

  .principles-heading {
    max-width: 760px;
    margin: 0 auto 60px;
    text-align: center;
  }

  .principles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .principle-card {
    position: relative;
    min-height: 360px;
    padding: 34px;
    overflow: hidden;
    border: 1px solid rgb(148 163 184 / 18%);
    border-radius: 25px;
    background: white;
    box-shadow: 0 20px 45px rgb(15 23 42 / 6%);
  }

  .principle-number {
    position: absolute;
    right: 22px;
    bottom: -15px;
    color: rgb(37 99 235 / 6%);
    font-size: 7rem;
    font-weight: 900;
  }

  .principle-icon {
    width: 55px;
    height: 55px;
    display: grid;
    place-items: center;
    margin-bottom: 34px;
    border-radius: 17px;
    color: white;
    background: linear-gradient(
      135deg,
      var(--primary),
      var(--secondary)
    );
    font-size: 1.3rem;
    font-weight: 900;
    box-shadow: 0 15px 30px rgb(37 99 235 / 22%);
  }

  .principle-card h3 {
    margin: 0 0 16px;
    color: var(--navy);
    font-size: 1.4rem;
  }

  .principle-card p {
    position: relative;
    z-index: 1;
    margin: 0;
    color: var(--muted);
    line-height: 1.8;
  }

  .about-values {
    padding: 110px 0;
    background: white;
  }

  .values-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 90px;
  }

  .values-intro {
    position: sticky;
    top: 120px;
    align-self: start;
  }

  .values-list {
    display: grid;
  }

  .values-list article {
    display: grid;
    grid-template-columns: 55px 1fr;
    gap: 25px;
    padding: 32px 0;
    border-bottom: 1px solid var(--border);
  }

  .values-list article:first-child {
    padding-top: 0;
  }

  .values-list article > span {
    color: var(--primary);
    font-size: 0.78rem;
    font-weight: 900;
  }

  .values-list h3 {
    margin: 0 0 10px;
    color: var(--navy);
    font-size: 1.25rem;
  }

  .values-list p {
    margin: 0;
    color: var(--muted);
    line-height: 1.7;
  }

  .about-cta {
    padding: 30px 0 100px;
    background: white;
  }

  .cta-box {
    padding: 80px 30px;
    border-radius: 34px;
    color: white;
    text-align: center;
    background:
      radial-gradient(
        circle at 15% 20%,
        rgb(255 255 255 / 18%),
        transparent 25%
      ),
      linear-gradient(135deg, #1d4ed8, #2563eb 60%, #0891b2);
    box-shadow: 0 30px 70px rgb(37 99 235 / 25%);
  }

  .cta-box > span {
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .cta-box h2 {
    max-width: 740px;
    margin: 18px auto;
    color: white;
    font-size: clamp(2.2rem, 5vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.045em;
  }

  .cta-box p {
    max-width: 620px;
    margin: 0 auto 30px;
    color: rgb(255 255 255 / 78%);
    line-height: 1.75;
  }

  .cta-box a {
    min-height: 52px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 26px;
    border-radius: 12px;
    color: var(--primary);
    background: white;
    font-weight: 800;
    box-shadow: 0 15px 35px rgb(15 23 42 / 18%);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .cta-box a:hover {
    transform: translateY(-3px);
    box-shadow: 0 20px 42px rgb(15 23 42 / 24%);
  }

  @media (max-width: 900px) {
    .story-grid,
    .values-grid {
      grid-template-columns: 1fr;
      gap: 55px;
    }

    .principles-grid {
      grid-template-columns: 1fr;
      max-width: 650px;
      margin-inline: auto;
    }

    .values-intro {
      position: static;
    }
  }

  @media (max-width: 620px) {
    .about-hero {
      padding: 85px 0;
    }

    .about-hero h1 {
      font-size: clamp(2.7rem, 13vw, 4.4rem);
    }

    .about-story,
    .about-principles,
    .about-values {
      padding: 80px 0;
    }

    .story-visual {
      min-height: 370px;
    }

    .visual-card-small {
      right: 10px;
      bottom: 15px;
    }

    .principle-card {
      min-height: auto;
    }

    .cta-box {
      padding: 60px 24px;
      border-radius: 25px;
    }
  }
</style>